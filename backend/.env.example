# Copy this file to backend/.env. Never commit backend/.env or paste its secrets.
# Supabase transaction-pooler example; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
FRONTEND_ORIGIN=http://localhost:5173

# Fresh M4 Sepolia handoff. Copy the public address and deployment block from
# deployments/sepolia-2026-11-02/manifest.post-setup.json only after verifying
# its ABI digest and chain ID.
INDEXER_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://sepolia.example.invalid
PREDICTION_MARKET_ADDRESS=
PREDICTION_MARKET_DEPLOYMENT_BLOCK=0
PREDICTION_MARKET_ABI_PATH=../deployments/abi/PredictionMarket.abi.json

# Run exactly one indexer worker.
INDEXER_CONFIRMATION_DEPTH=2
INDEXER_BLOCK_BATCH_SIZE=10
INDEXER_POLL_INTERVAL_SECONDS=5
INDEXER_RPC_TIMEOUT_SECONDS=10
INDEXER_RPC_MAX_ATTEMPTS=3
INDEXER_RPC_BACKOFF_SECONDS=0.5

# Separate restricted Sepolia accounts. Send only their public addresses to
# the deployer for REGISTRAR_ROLE and PROPOSER_ROLE grants.
REGISTRAR_PRIVATE_KEY=
PROPOSER_PRIVATE_KEY=
SIGNER_CONFIRMATION_DEPTH=2
SIGNER_POLL_INTERVAL_SECONDS=5

# Server-side only. Enable only after provider/team approval.
PANDASCORE_API_TOKEN=
PANDASCORE_USE_APPROVED=false
