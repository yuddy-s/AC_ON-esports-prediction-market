# Copy to .env.local (gitignored) and fill in. Only VITE_* values reach the
# browser, so never put private keys, RPC secrets or database URLs here.

# "sepolia" for the real demo, "anvil" for a local Foundry chain on 127.0.0.1:8545.
VITE_CHAIN=sepolia

# Ethereum Sepolia M3 deployment (deployments/sepolia-m3.json). Public values.
VITE_PREDICTION_MARKET_ADDRESS=0x19EF739001038Ce9DFB1E12Cf45A10c9250A60a7
VITE_ACON_TOKEN_ADDRESS=0x315FCA0DDAA367446f36A3184D8f6b2Df76b5618
VITE_DEMO_MARKET_ID=0

# FastAPI backend, e.g. http://localhost:8000 locally.
VITE_API_URL=http://localhost:8000

# Local Anvil values (contracts/script/Deploy.s.sol on a fresh Anvil always
# deploys to these addresses):
# VITE_CHAIN=anvil
# VITE_ACON_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# VITE_PREDICTION_MARKET_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# Optional: which Anvil default account the local test wallet uses
# (default #0 = deployer, already claimed the faucet). Account #1:
# VITE_ANVIL_ACCOUNT=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
