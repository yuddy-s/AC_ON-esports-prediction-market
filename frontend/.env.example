# Copy to .env.local (gitignored) and fill in. Only VITE_* values reach the
# browser, so never put private keys, RPC secrets or database URLs here.

# "sepolia" for the real demo, "anvil" for a local Foundry chain on 127.0.0.1:8545.
VITE_CHAIN=sepolia

# Ethereum Sepolia M4 deployment, 2026-11-02
# (deployments/sepolia-2026-11-02/manifest.post-setup.json). Public values.
# The frontend uses the M4 ABI; the older M3 addresses in sepolia-m3.json do not
# work with it.
VITE_PREDICTION_MARKET_ADDRESS=0x03ae48f03C7822540a91DA2168602bd49dC510E9
VITE_ACON_TOKEN_ADDRESS=0xf85b2278a810410c6AE0b7490d34671E0C8e6E90
VITE_DEMO_MARKET_ID=0

# FastAPI backend, e.g. http://localhost:8000 locally. It must index the same
# chain and PredictionMarket address, or the "indexed" step and history stay hidden.
VITE_API_URL=http://localhost:8000

# Fixture catalog source: "api" (backend /api/fixtures) or "mock" (fictional
# fixtures bundled with the frontend). Defaults to api when VITE_API_URL is set.
# VITE_FIXTURE_SOURCE=mock

# Local Anvil: use the ACONTestToken and PredictionMarket addresses printed by
# your local M4 deployment. On a fresh Anvil the token is always the first
# deployment; the market address depends on what is deployed before it (for
# example a mock VRF coordinator).
# VITE_CHAIN=anvil
# VITE_ACON_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# VITE_PREDICTION_MARKET_ADDRESS=<PredictionMarket address from your deploy>
# Optional: which Anvil default account the local test wallet uses
# (default #0 = deployer, already claimed the faucet). Account #1:
# VITE_ANVIL_ACCOUNT=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
