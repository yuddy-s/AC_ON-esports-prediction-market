# Ethereum Sepolia public RPC. You may replace this with a provider URL.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Use a dedicated, funded Ethereum Sepolia test wallet. Never commit a real key.
SEPOLIA_PRIVATE_KEY=0xreplace_with_test_wallet_private_key

# Reviewed public Safe/role/VRF configuration for the current deployment script.
SAFE_ADDRESS=0xreplace_with_deployed_safe
SAFE_OWNER_BENNY=0xreplace_with_public_owner_address
SAFE_OWNER_MATTHEW=0xreplace_with_public_owner_address
SAFE_OWNER_ADRIEL=0xreplace_with_public_owner_address
REGISTRAR_ADDRESS=0xreplace_with_yudhveers_registrar_address
PROPOSER_ADDRESS=0xreplace_with_yudhveers_separate_proposer_address
VRF_COORDINATOR=0xreplace_from_current_official_sepolia_vrf_v2_5_config
VRF_KEY_HASH=0xreplace_with_official_sepolia_key_hash
VRF_SUBSCRIPTION_ID=0
VRF_CALLBACK_GAS_LIMIT=2000000
